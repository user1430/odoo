# ===== Odoo 连接配置（在 WorkBuddy 的 MCP 配置或 shell 环境中设置）=====
ODOO_URL=http://localhost:8069
ODOO_DB=odoo
# 建议使用一个最小权限的专用 Odoo 业务账号，而非 admin
ODOO_USER=odoo_api
ODOO_PASSWORD=change_me
# 只读模式：true 禁止所有写操作（create/write），更安全
ODOO_READONLY=true

# ===== MCP 传输方式 =====
# stdio（默认）：本机子进程模式，供本机 WorkBuddy/CodeBuddy 接入，无网络地址
# streamable-http：对外 HTTP 服务，端点 /mcp（推荐，MCP 2025-03 规范）
# sse：旧版 HTTP 传输，端点 /sse（兼容仅支持 SSE 的客户端）
MCP_TRANSPORT=stdio
# HTTP 模式监听地址/端口；对外部署改为 0.0.0.0
MCP_HOST=127.0.0.1
MCP_PORT=8080
# ===== HTTP 鉴权（仅 HTTP 传输生效）=====
# 鉴权模式：仅 oauth（静态 token 通道已移除；填 static/both 会启动报错）
MCP_AUTH_MODE=oauth
# OAuth 校验协议（二选一，introspection 优先）：
# 1) introspection（RFC 7662，推荐）：POST，active=true 放行；配了端点则凭据必填
OAUTH_INTROSPECTION_ENDPOINT=https://odoomcp.duckdns.org/token/introspection
OAUTH_INTROSPECTION_CLIENT_ID=
OAUTH_INTROSPECTION_CLIENT_SECRET=
# 2) userinfo：GET，200=token 有效，401=无效；未配置 introspection 时使用
OAUTH_USERINFO_ENDPOINT=https://odoomcp.duckdns.org/me
# OAuth 校验正缓存 TTL（秒）；负缓存固定 60s
OAUTH_TOKEN_CACHE_TTL=300
# ===== OAuth 发现（RFC 9728 资源元数据，一般无需修改）=====
# 资源服务器公网地址（well-known 输出的 resource 前缀）
MCP_PUBLIC_URL=https://odoomcpdemo.duckdns.org
# well-known 输出的 authorization_servers
OAUTH_AUTHORIZATION_SERVER=https://odoomcp.duckdns.org
