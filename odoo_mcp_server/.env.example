# ===== Odoo 连接配置（在 WorkBuddy 的 MCP 配置或 shell 环境中设置）=====
ODOO_URL=http://localhost:8069
ODOO_DB=odoo
# 建议使用一个最小权限的专用 Odoo 业务账号，而非 admin
ODOO_USER=odoo_api
ODOO_PASSWORD=change_me
# 只读模式：true 禁止所有写操作（create/write），更安全
ODOO_READONLY=true

# ===== MCP 传输方式 =====
# stdio（默认）：本机子进程模式，供本机 WorkBuddy/CodeBuddy 接入，无网络地址
# streamable-http：对外 HTTP 服务，端点 /mcp（推荐，MCP 2025-03 规范）
# sse：旧版 HTTP 传输，端点 /sse（兼容仅支持 SSE 的客户端）
MCP_TRANSPORT=stdio
# HTTP 模式监听地址/端口；对外部署改为 0.0.0.0
MCP_HOST=127.0.0.1
MCP_PORT=8080
# ===== HTTP 鉴权（仅 HTTP 传输生效）=====
# 鉴权模式：static（仅静态 Token）/ oauth（仅 OAuth 校验）/ both（先静态后 OAuth，默认）
# 回滚位：线上改为 static 并重启即恢复改造前行为
MCP_AUTH_MODE=both
# 静态 Bearer Token；mode 含 static 时使用。未配置时 static 路径永不匹配（fail-closed）
MCP_AUTH_TOKEN=
# OAuth userinfo 校验端点（GET，200=token 有效，401=无效）；换 IdP 只需改这里
OAUTH_USERINFO_ENDPOINT=https://copilot.tencent.com/oauth2/userinfo
# OAuth 校验正缓存 TTL（秒）；负缓存固定 60s
OAUTH_TOKEN_CACHE_TTL=300
